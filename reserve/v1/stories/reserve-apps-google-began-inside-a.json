O","O","O"],"dur":4.07,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t3-2.m4a","durJa":5.22,"times":[0.0,0.08,0.4,0.72,1.14,1.6,1.72,1.92,2.32,2.76,3.16,3.38]},{"text":"In September 1998, the pair moved their work out of their campus dorm.","voice":"voice/reserve-apps-google-began-inside-a/t3-3.m4a","roles":["M","M","M","S","S","V","O","O","M","M","M","M","M"],"dur":4.19,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t3-3.m4a","durJa":5.74,"times":[0.0,0.08,0.4,1.76,1.88,2.04,2.32,2.56,2.8,3.1,3.26,3.38,3.7]},{"text":"They rented a Menlo Park garage from Susan Wojcicki for 1,700 dollars per month.","voice":"voice/reserve-apps-google-began-inside-a/t3-4.m4a","roles":["S","V","O","O","O","O","M","M","M","M","M","M","M","M"],"dur":5.14,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t3-4.m4a","durJa":5.83,"times":[0.0,0.08,0.28,0.56,0.96,1.18,1.58,2.08,2.4,3.1,3.4,3.86,4.52,4.68]},{"text":"Wojcicki eventually became the 16th employee at Google and later managed YouTube.","voice":"voice/reserve-apps-google-began-inside-a/t3-5.m4a","roles":["S","M","V","C","C","C","C","C","M","M","V","O"],"dur":4.83,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t3-5.m4a","durJa":6.05,"times":[0.0,0.54,0.82,1.34,1.54,2.16,2.42,2.76,2.94,3.54,3.78,4.22]},{"text":"That rented space has since become a famous origin story in technology.","voice":"voice/reserve-apps-google-began-inside-a/t3-6.m4a","roles":["S","S","S","V","M","V","C","C","C","C","C","C"],"dur":4.45,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t3-6.m4a","durJa":5.69,"times":[0.0,0.18,0.32,0.74,1.02,1.26,1.54,1.8,2.2,2.54,3.12,3.32]}],"bands":{"core1000":77,"core1800":8,"ngsl":3,"tsl":4,"nawl":1,"beyond":7},"grammar":[{"i":1,"focus":", which is a calculation rule,","title":"Non-defining Relative Clause","note":"Relative clauses starting with 'which' after a comma provide supplementary information. Here, it defines what an algorithm is without altering the main sentence structure."},{"i":6,"focus":"has since become","title":"Present Perfect Tense","note":"The present perfect 'has become' connects a past event to present reality. Inserting 'since' emphasizes that this status has continued uninterrupted from the past to now."}]},"t4":{"sentences":[{"text":"Long before Google became a major corporation, it began as an academic project at Stanford University.","voice":"voice/reserve-apps-google-began-inside-a/t4-0.m4a","roles":["M","M","S","V","C","C","C","S","V","M","M","M","M","M","M","M"],"dur":6.83,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t4-0.m4a","durJa":8.27,"times":[0.0,0.28,0.72,1.12,1.56,1.84,2.06,3.46,3.54,3.78,4.08,4.2,4.5,5.28,5.52,5.88]},{"text":"In 1996, graduate students Larry Page and Sergey Brin created an algorithm, or calculation rule, to rank pages.","voice":"voice/reserve-apps-google-began-inside-a/t4-1.m4a","roles":["M","M","S","S","S","S","S","S","S","V","O","O","O","O","O","M","M","M"],"dur":8.91,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t4-1.m4a","durJa":11.59,"times":[0.0,0.06,1.46,1.82,2.46,2.82,3.22,3.6,3.86,4.44,5.0,5.3,6.44,6.46,6.88,7.78,7.94,8.14]},{"text":"Their early software was nicknamed BackRub because it analyzed links to determine web page importance.","voice":"voice/reserve-apps-google-began-inside-a/t4-2.m4a","roles":["S","S","S","V","V","C","M","S","V","O","M","M","M","M","M"],"dur":6.03,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t4-2.m4a","durJa":9.27,"times":[0.0,0.1,0.4,0.82,1.22,1.56,2.32,2.9,3.08,3.36,3.88,4.24,4.52,4.9,5.16]},{"text":"As user demand expanded, the creators moved their operation out of university student housing.","voice":"voice/reserve-apps-google-began-inside-a/t4-3.m4a","roles":["M","S","S","V","S","S","V","O","O","M","M","M","M","M"],"dur":5.47,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t4-3.m4a","durJa":8.13,"times":[0.0,0.1,0.26,0.62,1.76,1.86,2.18,2.62,2.9,3.3,3.8,4.06,4.42,4.96]},{"text":"In September 1998, a garage in Menlo Park was rented from Susan Wojcicki for 1,700 dollars monthly.","voice":"voice/reserve-apps-google-began-inside-a/t4-4.m4a","roles":["M","M","M","S","S","S","S","S","V","V","M","M","M","M","M","M","M"],"dur":7.03,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t4-4.m4a","durJa":8.55,"times":[0.0,0.06,0.28,1.94,2.04,2.28,2.72,3.06,3.38,3.64,3.88,4.2,4.5,5.16,5.52,6.06,6.6]},{"text":"This modest location served as Google's initial headquarters while the search technology was expanded.","voice":"voice/reserve-apps-google-began-inside-a/t4-5.m4a","roles":["S","S","S","V","M","M","M","M","M","S","S","S","V","V"],"dur":5.38,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t4-5.m4a","durJa":6.6,"times":[0.0,0.14,0.48,0.96,1.52,1.78,2.26,2.58,3.14,3.72,3.84,4.02,4.4,4.82]},{"text":"Wojcicki eventually joined the company as its 16th employee and later became the head of YouTube.","voice":"voice/reserve-apps-google-began-inside-a/t4-6.m4a","roles":["S","M","V","O","O","M","M","M","M","M","M","V","C","C","C","C"],"dur":5.44,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t4-6.m4a","durJa":7.72,"times":[0.0,0.58,0.92,1.34,1.62,1.9,2.18,2.3,2.96,3.28,3.92,4.12,4.48,4.68,4.86,4.98]},{"text":"That rented garage is now recognized as an iconic landmark in technological history.","voice":"voice/reserve-apps-google-began-inside-a/t4-7.m4a","roles":["S","S","S","V","M","V","M","M","M","M","M","M","M"],"dur":5.43,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t4-7.m4a","durJa":7.23,"times":[0.0,0.14,0.38,0.82,1.2,1.44,1.8,2.28,2.38,2.68,3.38,3.74,4.08]}],"bands":{"core1000":71,"core1800":13,"ngsl":4,"tsl":4,"nawl":1,"beyond":7},"grammar":[{"i":2,"focus":"was nicknamed BackRub","title":"Passive Voice with Complement","note":"The passive form 'was nicknamed' shifts the receiver of the action to subject position. The name 'BackRub' remains as a complement following the passive verb."},{"i":5,"focus":"while the search technology was expanded.","title":"Time Clause with Passive","note":"The conjunction 'while' introduces a background time clause. Using passive voice ('was expanded') keeps focus on the technology being developed rather than on who developed it."}]},"t5":{"sentences":[{"text":"Long before Google transformed into an internet giant, it originated as a modest academic research project at Stanford University in 1996.","voice":"voice/reserve-apps-google-began-inside-a/t5-0.m4a","roles":["M","M","S","V","M","M","M","M","S","V","M","M","M","M","M","M","M","M","M","M","M"],"dur":10.14,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t5-0.m4a","durJa":12.48,"times":[0.0,0.32,0.66,1.1,1.76,2.36,2.5,2.8,3.9,4.08,4.46,4.98,5.08,5.4,5.88,6.4,7.08,7.36,7.64,8.4,8.8]},{"text":"Doctoral students Larry Page and Sergey Brin devised a search algorithm, an automated calculation system, which evaluated web pages based on links.","voice":"voice/reserve-apps-google-began-inside-a/t5-1.m4a","roles":["S","S","S","S","S","S","S","V","O","O","O","O","O","O","O","S","V","O","O","M","M","M"],"dur":9.36,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t5-1.m4a","durJa":11.03,"times":[0.0,0.36,0.7,1.1,1.46,1.84,2.08,2.62,3.02,3.34,3.54,4.66,4.7,5.12,5.52,6.64,6.84,7.26,7.72,8.12,8.46,8.7]},{"text":"Dubbed BackRub for its focus on backlinks, the primitive system quickly proved far superior to existing search tools of that era.","voice":"voice/reserve-apps-google-began-inside-a/t5-2.m4a","roles":["M","M","M","M","M","M","M","S","S","S","M","V","C","C","C","C","C","C","C","C","C"],"dur":7.9,"voiceJa":"voice/reserve-apps-google-began-inside-a/ja/t5-2.m4a","durJa":10.89,"times":[0.0,0.34,0.94,1.28,1.42,1.66,2.0,2.96,3.16,3.4,3.86,4.22,4.68,5.08,5.64,6.02,6.28,6.72,7.08,7.26,7.38]},{"text":"By September 1998, rapid user growth prompted the pair to relocate their expanding operations out of campus dorm rooms.","voice":"voice/reserve-apps-google-began-inside-a/t5-3.m4a","roles":["M","M","M","S","S","S","V","O","O","C","C","C","C","C","C","C",